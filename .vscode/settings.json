{
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  // Deno language server — scoped to Edge Functions only.
  // This prevents the Node TS server from linting Deno files
  // (which causes "Cannot find module 'https://...' " errors).
  "deno.enable": true,
  "deno.enablePaths": ["supabase/functions"],
  "deno.lint": true,
  "deno.unstable": false,
  // Exclude Deno paths from Node/TS server to avoid double-linting
  "typescript.tsserver.watchOptions": {},
  "[typescript]": {
    "editor.defaultFormatter": "denoland.vscode-deno"
  }
}